{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pious",
  "identifier": "com.pious.bootstrapper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "splash",
        "title": "Pious",
        "url": "index.html",
        "width": 620,
        "height": 260,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://*.rbxcdn.com data:; style-src 'self' 'unsafe-inline'; font-src 'self' data: asset: http://asset.localhost; frame-src asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "version": "1.0.2"
}